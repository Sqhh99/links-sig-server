# Deployment environment configuration
# Copy this file to .env.deploy and update values for your environment.

# Optional image override used by docker-compose.deploy.yml
APP_IMAGE=links-sig-rust-server:latest

# Host port exposed by Docker Compose
HOST_PORT=8081

# Env file path used by docker-compose.deploy.yml
DEPLOY_ENV_FILE=.env.deploy

# ============================================================================
# LiveKit Settings
# ============================================================================
# Use an address reachable from inside the container.
LIVEKIT_URL=http://host.docker.internal:7880
LIVEKIT_WS_URL=ws://livekit.example.com
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# ============================================================================
# Server Settings
# ============================================================================
SERVER_PORT=8081
SERVER_HOST=0.0.0.0
APP_BASE_URL=https://app.example.com

# TLS is terminated by the reverse proxy / load balancer.
ENABLE_HTTPS=false
SSL_CERT_FILE=./certs/server.crt
SSL_KEY_FILE=./certs/server.key

# ============================================================================
# Database Settings
# ============================================================================
# Never use localhost here unless PostgreSQL runs inside this same container.
DATABASE_URL=postgres://links_sig:replace-with-password@host.docker.internal:5432/links_sig
MEETING_LIFECYCLE_INTERVAL_SECS=60
MEETING_LIFECYCLE_LOCK_KEY=424242

# ============================================================================
# JWT Settings (User Authentication)
# ============================================================================
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_EXPIRATION_SECS=604800
