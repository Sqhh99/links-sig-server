# docker compose 的配置文件模板。
# 复制为同目录下的 .env 再修改：cp .env.example .env
# 标注「必填」的项留空时，docker compose 会直接报错并提示缺哪一项。

# ============================================================================
# 密钥（必填）
# ============================================================================
# 生成随机值：openssl rand -hex 32

# 用户登录 token 的签名密钥。泄露后任何人都能伪造登录。
JWT_SECRET=

# LiveKit 的 API key / secret，服务端和 LiveKit 共用这一组。
# secret 至少 32 个字符，否则 LiveKit 拒绝启动。
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# ============================================================================
# 客户端能访问到的地址
# ============================================================================
# 服务端下发给客户端的 LiveKit 信令地址。
#   只在本机用：ws://127.0.0.1:7880
#   局域网：    ws://<本机局域网 IP>:7880
#   公网：      ws://<公网 IP 或域名>:7880，或反向代理后的 wss://...
LIVEKIT_WS_URL=ws://127.0.0.1:7880

# LiveKit 告诉客户端「媒体流发到哪个 IP」。要和上面的地址指向同一台机器，
# 但只能填 IP，不能填域名。
#   只在本机用：127.0.0.1
#   局域网：    本机局域网 IP，例如 192.168.1.10
#   公网：      服务器公网 IP
LIVEKIT_NODE_IP=127.0.0.1

# 会议分享链接的前缀，服务端自带的 /join 页面就在 8081 端口上。
APP_BASE_URL=http://127.0.0.1:8081

# ============================================================================
# PostgreSQL
# ============================================================================
# 用户名、密码、库名只在第一次创建数据卷时生效，之后再改不会影响已有数据库。
# 密码请只用字母和数字，它会被直接拼进 DATABASE_URL。
POSTGRES_USER=links_sig
POSTGRES_PASSWORD=links_sig_password
POSTGRES_DB=links_sig

# 数据卷名。想沿用旧的 docker/postgres-docker 的数据，改成 postgres-docker_postgres_data。
POSTGRES_VOLUME=links_postgres_data

# ============================================================================
# 宿主机端口
# ============================================================================
# links-sig-server 的 HTTP 端口，客户端的「服务器地址」填 http://<主机>:<这个端口>。
SERVER_PORT=8081
# PostgreSQL 只绑定 127.0.0.1，给本机的 psql 和 cargo run 用。
POSTGRES_PORT=5432

# ============================================================================
# 其他
# ============================================================================
# 登录 token 有效期（秒），默认 7 天。
JWT_EXPIRATION_SECS=604800
# 会议生命周期任务的扫描间隔（秒）。
MEETING_LIFECYCLE_INTERVAL_SECS=60
